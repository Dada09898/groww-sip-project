# Which AI to use: gemini (free tier) or anthropic (paid)
LLM_PROVIDER=gemini

# Free: aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_TAG_MODEL=gemini-flash-lite-latest
GEMINI_SYNTH_MODEL=gemini-flash-latest
GEMINI_RPM=10

# Paid alternative: platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
TAG_MODEL=claude-haiku-5-5
SYNTH_MODEL=claude-sonnet-5-5

# YouTube comments: console.cloud.google.com -> YouTube Data API v3 -> API key
YOUTUBE_API_KEY=

# Reddit no longer gives new API keys (Nov 2025). Leave empty; add Reddit posts to data/social_manual.csv
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
